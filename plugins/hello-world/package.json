{
  "name": "@dshforge/hello-world",
  "version": "0.1.3",
  "type": "module",
  "description": "Hello-world client plugin for dsh-forge: a quiet status bar in the shell.bottom slot, styled with the dsh-forge DESIGN.md tokens.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cndoit18/dsh-forge.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "license": "Apache-2.0"
}
