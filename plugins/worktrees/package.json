{
  "name": "@dshforge/worktrees",
  "version": "0.1.0",
  "type": "module",
  "description": "Create Git worktrees on first send, with chat-fork isolation and managed cleanup.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cndoit18/dsh-forge.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run --config tests/vitest.config.mjs && node tests/build-client.mjs && node --test .test-dist/client.test.mjs tests/module.test.mjs",
    "test:coverage": "vitest run --config tests/vitest.config.mjs --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov --coverage.reportsDirectory=./coverage --coverage.thresholds.100=false"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.3 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-store": "link:../../third_party/deepseek-harness/packages/client/store",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../third_party/deepseek-harness/packages/client/ui-primitives",
    "@testing-library/react": "^16.3.3",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "^0.28.2",
    "jsdom": "^27.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "4.1.11"
  },
  "license": "Apache-2.0"
}
